<h1 class="title">Our Dance Courses</h1>
<p class="subtitle">Choose from a variety of courses designed for all experience levels.</p>

<section class="courses">
  {{#courses}}
    <div class="course-card">
      <h2>{{name}}</h2>
      <p><strong>Level:</strong> {{level}}</p>
      <p><strong>Instructor:</strong> {{instructor}}</p>
      <p><strong>Time:</strong> {{time}}</p>
      <a href="/bookings/new/{{_id}}" class="btn">Book Now</a>
    </div>
  {{/courses}}

  {{^courses}}
    <p>No courses available at the moment. Please check back soon!</p>
  {{/courses}}
</section>

<style>
  .courses {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    padding: 1rem;
  }
  .course-card {
    border: 1px solid #ccc;
    border-radius: 12px;
    padding: 1rem;
    width: 300px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
  .btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    background-color: #5e60ce;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    margin-top: 0.5rem;
  }
</style>