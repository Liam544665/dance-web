<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Header with logo and nav -->
  <header class="navbar">
    <div class="container">
      <div class="logo">
        <a href="/">
          <img src="/images/brandkit/dancevibe-high-resolution-logo.png" alt="DanceVibe Logo">
        </a>
      </div>
      <nav>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/courses">Courses</a></li>
          {{#user}}
            <li><a href="/bookings">My Bookings</a></li>
            <li><a href="/profile">Profile</a></li>
            {{#user.isAdmin}}
              <li><a href="/admin">Admin</a></li>
            {{/user.isAdmin}}
            <li><a href="/auth/logout">Logout</a></li>
          {{/user}}
          {{^user}}
            <li><a href="/auth/login">Login</a></li>
            <li><a href="/auth/register">Register</a></li>
          {{/user}}
        </ul>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main class="container">
    {{{body}}}
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <p>&copy; 2025 DanceVibe</p>
    </div>
  </footer>
</body>
</html>



